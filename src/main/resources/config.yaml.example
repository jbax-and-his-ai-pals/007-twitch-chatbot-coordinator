debug: false

# Port the embedded GUI control panel listens on - open http://localhost:PORT once running.
# Note: any tuning done through the GUI is saved to data/state.json and restored on the next
# startup, taking priority over the values below - edit this file for the baseline you want
# to start from, use the GUI for live tuning. Delete data/state.json to fall back to this
# file again.
gui_port: 8080

# Channels - every bot account joins every channel listed here
channels:
    - "thecheeseball81"
    - "jerbtrundles"

# Every LLM the GUI's model dropdown can switch real (non-mocked) calls to. "default" is what a
# fresh run starts on; switching in the GUI is session-only, never persisted (same as fallback
# mode) - a restart always comes back up on this default. Two providers:
#   - "ollama": a model served by a locally-running Ollama (https://ollama.com) instance - free
#     and offline. `ollama pull gemma4:12b` (about 8 GB, fits a 16 GB GPU), keep Ollama
#     running, and "model_name" is whatever `ollama list` shows (defaults to "key" if omitted).
#     gemma4:12b won a head-to-head against six other local models on this app's own logged
#     chats: it passed production's transform checks 95% of the time, vs 90% for the
#     gemini-2.5-flash-lite responses it replaces (the others managed 57-68%).
#   - "vertex": the billed Vertex AI/Gemini client (project and model are hardcoded in
#     core/AIModel.kt). Opt-in only - nothing falls back to it. Uncomment the entry below to
#     offer it in the dropdown.
models:
    ollama_base_url: "http://localhost:11434"
    default: "gemma4-12b"
    available:
        - key: "gemma4-12b"
          provider: "ollama"
          model_name: "gemma4:12b"
        # - key: "gemini"
        #   provider: "vertex"

# Bots that share ONE ambient mainline-transform timer instead of each running its own -
# only one of them acts per interval, chosen at random when several are eligible for the
# same message, so the group takes turns rather than piling onto the same chat line (see
# MainlinePool). A bot NOT listed here keeps its own independent timer, exactly as before.
#
# TWO things to know before editing this list:
#   1. Fewer than two entries means no pooling at all - every bot keeps its own timer.
#   2. The pool's timing (interval bounds, start delay, minimum messages between) is seeded
#      from the FIRST bot listed here, so ordering matters at runtime as much as membership.
#
# This is the list to extend as more bots join the rotation. Note it shares the MAINLINE
# timer only: each bot's wisdom/request/callout/retry timers stay its own.
mainline_pool:
    - "blampbot"
    - "toikeybot"

# How many of the most recently mainline-transformed chatters, shared across EVERY bot (not
# just mainline_pool members - buttsbot's own independent timer respects this too), no bot
# may target again - keeps the group from piling onto the same person's messages back to
# back just because a different bot's turn came up. 0 disables this entirely. Also editable
# live from the GUI's "Common configuration" panel. The channel owner is always exempt.
recent_mainline_target_limit: 3

# Shared baseline every bot starts from. message_length/similarity_threshold/cooldowns are
# a one-time per-bot starting point (each bot can override them, then they're independent -
# also editable per-bot from the GUI's Configure panel). excluded_users/callout_words/
# forbidden_words/callout_response_overrides work differently: they seed a single shared,
# live "common configuration" every bot checks *in addition to* its own list (see each
# bot's own `..._add` fields below) - editable from the GUI's "Common configuration" panel,
# and a change there applies to every bot immediately, no restart needed.
defaults:
    message_length:
        minimum: 20
        maximum: 100
    similarity_threshold: 70

    excluded_users:
        - "nightbot"
        - "b_a_618"
        - "bowlymania"
        - "jaedubbs"
        - "quacksplat"
        - "bedwablackburn"

    callout_words:
        - "name something people take with them to the beach"
        - "the first thing you buy at a supermarket"
        - "a food often stuffed"
        - "turkey tits"
        - "durrrr key"
        - "spaghetti"
        - "rigatoni"
        - "gabagool"
        - "asshole"
        - "boobies"
        - "titties"
        - "turkey"

    forbidden_words:
        - "_"
        - "@"
        - "gg"
        - "http"
        - "addcheese"
        - "depress"
        - "moist"
        - "cheer"
        - "hype"
        - "lbd"
        - "lewy"
        - "dementia"
        - "hahasweat"
        - "derpybarba"
        - "barbacoffee"
        - "family"
        - "tombraid"
        - "kappa"
        - "lul"
        - "thanks"
        - "follow"
        - "pok"
        - "thecheeseball81"
        - "young"
        - "kid"
        - "child"
        - "cousin"
        - "daughter"
        - "son"
        - "mom"
        - "dad"
        - "brother"
        - "sister"
        - "die"
        - "death"
        - "cheese"
        - "medical"
        - "health"
        - "charity"
        - "singsnote"
        - "rose"
        - "coolstorybob"

    # Special-cased responses for specific callout words; anything else falls back to "$WORD!"
    callout_response_overrides:
        "durrrr key": "DOIKEY!"
        "turkey": "TOIKEY!"
        "name something people take with them to the beach": "TOIKEY!"
        "the first thing you buy at a supermarket": "TOIKEY!"
        "a food often stuffed": "TOIKEY!"
        "turkey tits": "TOIKEY TITS!"

    cooldowns:
        wisdom_ms: 30000
        # callout_ms is ONE window shared by every bot, not a per-bot timer: at most one callout
        # ("TURKEY!") is answered per window across the whole group, and the right to answer
        # rotates round-robin through the bots in `bots:` order. A callout inside the window is
        # swallowed (including another bot echoing the first one's reply). Editing it per bot in
        # the GUI edits the same shared value.
        callout_ms: 30000
        retry_ms: 0
        request_ms: 30000

    # Greeting phrases every bot recognizes, on top of whatever each bot adds via its own
    # `hello_triggers_add` below - editable live from the GUI's "Common configuration" panel,
    # same as the word/user lists above. {ref} expands to every way a bot can be addressed
    # (each of its trigger_keywords, bare and "@"-prefixed).
    hello_triggers:
        - starts_with: "hi {ref}"
        - starts_with: "hi, {ref}"
        - starts_with: "hey {ref}"
        - starts_with: "hey, {ref}"
        - starts_with: "hello {ref}"
        - starts_with: "hello, {ref}"

bots:
    blampbot:
        account_username: "blampbot"
        trigger_keywords: ["blampbot"]
        ignore_other_bots: true

        api:
            twitch_client_id: "YOUR_CLIENT_ID"
            twitch_client_secret: "YOUR_CLIENT_SECRET"
        credentials:
            irc: "YOUR_IRC_TOKEN"

        cooldowns:
            mainline:
                start_delay_ms: 490000
                start_instantly: false
                interval_minimum_ms: 360000
                interval_maximum_ms: 490000
                minimum_messages_between: 20

        # Blampbot's own greetings, on top of the shared set in defaults.hello_triggers above.
        hello_triggers_add:
            - starts_with: "good evening, {ref}"
            - starts_with: "good evening {ref}"
            - starts_with: "hey there {ref}"
            - starts_with: "hey there, {ref}"

        transform:
            # Relative weights, not percentages - "blamp" here is 3x as likely as "tits" or
            # "melons" (60%/20%/20%). Also editable live via sliders in the GUI.
            words:
                - word: "blamp"
                  weight: 3
                - word: "tits"
                  weight: 1
                - word: "melons"
                  weight: 1
            self_quote_marker: "blampfied"
            # Skip sincere/sad/heavy lines (hospital, grief, politics...) before any model call. On by default;
            # set false to restore the old behaviour. Old prompt text is in docs/legacy-prompts.md.
            # sincere_gate: true

        moods:
            - name: "default"
              hello_prompt: "[user], a good friend, has just greeted you; could you provide a friendly response? just the response, please"
        active_mood: "default"

        prompts:
            voice: "you're basically tony soprano, a stereotypical italian-american new yorker with the accent and attitude;"
            transform: >-
                your job is to edit one chat message by REPLACING a word, or a piece of a word, with
                "{UPPER}" - a find-and-replace like the original twitch buttsbot, never an insertion.
                rules: (1) the edited message must have exactly the same number of words as the
                original, in the same order, and every word except the one you edit stays exactly as
                written; (2) replace ONE whole word, or ONE piece of a word, with "{UPPER}" (for a very
                long message you may do two); the replaced text must disappear - never add "{UPPER}" as
                an extra word, never put it next to the word it should replace, and never glue it onto a
                word without removing letters from that word; (3) pick the swap that is funniest:
                usually a plain noun, verb or adjective, ideally one whose sound or spelling invites a
                pun (for example 'the hamptons' becomes 'the {lower}tons', 'calculation' becomes
                'calcu{lower}', 'hate' becomes '{lower}'), and the sentence must still read like
                grammatical english with "{UPPER}" playing the same role as the word it replaced; (4)
                never edit names, usernames, @mentions, links, emotes or numbers; (5) keep it safe for a
                family-friendly chat: if the message is about death, illness, injury, grief, tragedy,
                politics, religion, self-harm, children, or anyone's looks or identity, or if the swap
                would insult a person, reply with the original message completely unchanged; (6) reply
                with only the edited message - no quotes and no explanation; examples of correct edits
                (your word here is {UPPER}): 'that was a rollercoaster' becomes 'that was a
                {lower}coaster'; 'i love this song so much' becomes 'i love this {lower} so much'; 'the
                boss fight was brutal' becomes 'the {lower} fight was brutal'; 'we should take a
                vacation' becomes 'we should take a vaca{lower}'; 'what time does the stream start'
                becomes 'what time does the {lower} start'; 'that jump was impossible to hit' becomes
                'that {lower} was impossible to hit'; examples where you must change nothing and reply
                with the message exactly as given: 'my grandmother passed away last night' stays 'my
                grandmother passed away last night'; 'this election will ruin the country' stays 'this
                election will ruin the country'; here's the string:
            wisdom: "i'd like for you to come up with a quick witticism that would come from {name}; it could be about anything; please make your response only the witticism itself"
            request: "respond to the following request, no matter how ridiculous it sounds; limit your response to 150 characters; here's the request: "

        features:
            - type: "easter_egg"
              when_hello: true
              also_contains: "turkey"
              response: "you tryna BLAMP wit' me?"

    buttsbot:
        account_username: "neobuttsbot"
        trigger_keywords: ["buttsbot", "neobuttsbot"]
        ignore_other_bots: true

        api:
            twitch_client_id: "YOUR_CLIENT_ID"
            twitch_client_secret: "YOUR_CLIENT_SECRET"
        credentials:
            irc: "YOUR_IRC_TOKEN"

        cooldowns:
            mainline:
                start_delay_ms: 210000
                start_instantly: true
                interval_minimum_ms: 240000
                interval_maximum_ms: 360000
                minimum_messages_between: 20

        # Buttsbot's own greetings, on top of the shared set in defaults.hello_triggers above -
        # "contains" instead of "starts_with" so a greeting works mid-message too, plus one
        # combo trigger the shared set doesn't cover.
        hello_triggers_add:
            - contains: "hi, {ref}"
            - contains: "hello, {ref}"
            - contains: "hi {ref}"
            - starts_with: "hey"
              also_contains: "{ref}"

        transform:
            words:
                - word: "butt"
                  weight: 1
            self_quote_marker: "buttified"

        moods:
            - name: "nice"
              hello_prompt: "[user], a good friend, has just greeted you; could you provide a medium-length, formal, friendly response? just the response, please"
            - name: "mean"
              hello_prompt: "[user] is a no good terrible person who has just said hello to you. could you provide a medium-length, crude response? just the response, please"
        active_mood: "nice"

        prompts:
            voice: ""
            transform: >-
                your job is to edit one chat message by REPLACING a word, or a piece of a word, with
                "{UPPER}" - a find-and-replace like the original twitch buttsbot, never an insertion.
                rules: (1) the edited message must have exactly the same number of words as the
                original, in the same order, and every word except the one you edit stays exactly as
                written; (2) replace ONE whole word, or ONE piece of a word, with "{UPPER}" (for a very
                long message you may do two); the replaced text must disappear - never add "{UPPER}" as
                an extra word, never put it next to the word it should replace, and never glue it onto a
                word without removing letters from that word; (3) pick the swap that is funniest:
                usually a plain noun, verb or adjective, ideally one whose sound or spelling invites a
                pun (for example 'the hamptons' becomes 'the {lower}tons', 'calculation' becomes
                'calcu{lower}', 'hate' becomes '{lower}'), and the sentence must still read like
                grammatical english with "{UPPER}" playing the same role as the word it replaced; (4)
                never edit names, usernames, @mentions, links, emotes or numbers; (5) keep it safe for a
                family-friendly chat: if the message is about death, illness, injury, grief, tragedy,
                politics, religion, self-harm, children, or anyone's looks or identity, or if the swap
                would insult a person, reply with the original message completely unchanged; (6) reply
                with only the edited message - no quotes and no explanation; examples of correct edits
                (your word here is {UPPER}): 'that was a rollercoaster' becomes 'that was a
                {lower}coaster'; 'i love this song so much' becomes 'i love this {lower} so much'; 'the
                boss fight was brutal' becomes 'the {lower} fight was brutal'; 'we should take a
                vacation' becomes 'we should take a vaca{lower}'; 'what time does the stream start'
                becomes 'what time does the {lower} start'; 'that jump was impossible to hit' becomes
                'that {lower} was impossible to hit'; examples where you must change nothing and reply
                with the message exactly as given: 'my grandmother passed away last night' stays 'my
                grandmother passed away last night'; 'this election will ruin the country' stays 'this
                election will ruin the country'; here's the string:
            wisdom: "i'd like for you to come up with a quick witticism that would come from {name}; it could be about anything; please make your response only the witticism itself"
            request: "respond to the following request, no matter how ridiculous it sounds; limit your response to 150 characters; here's the request: "

        features:
            - type: "retry"
              trigger_prefix: "try again, "

    # Inherits message length, similarity threshold, words, users, greetings and every
    # non-mainline cooldown from `defaults` above. Its mainline timer comes from the
    # `mainline_pool` at the top of this file rather than from itself, so it deliberately
    # declares no `cooldowns:` block - the pooled timer is seeded from blampbot, the first
    # bot listed in that pool. It DOES need its own `transform`/`prompts` block though: those
    # are what make it transform anything at all, and `defaults` supplies none of them.
    toikeybot:
        account_username: "toikeybot"
        trigger_keywords: ["toikeybot"]
        api:
            twitch_client_id: "YOUR_CLIENT_ID"
            twitch_client_secret: "YOUR_CLIENT_SECRET"
        credentials:
            irc: "YOUR_IRC_TOKEN"
        transform:
            words:
                - word: "toikey"
                  weight: 3
                - word: "tits"
                  weight: 1
                - word: "melons"
                  weight: 1
            self_quote_marker: "toikeyfied"
            # Also accept an edit that only turns one word's ur/er/ir/or sound into oi (word -> woid) without the theme word.
            sound_swap: true
            # How often a word is oi-swapped by rule (no model call) when the message has an ur/er/ir/or word; otherwise the model picks a theme-word swap.
            sound_swap_chance: 0.5

        # Brooklyn to blampbot's Jersey: where blampbot is a quiet, menacing mob boss, toikeybot is
        # the warm, chatty, unsolicited-opinions guy from the old neighborhood. The accent is
        # deliberately ONE rule - "ur"/"er"/"ir" sounds become "oi" (turkey -> toikey) - and
        # nothing else (no dese/dem/dose), so requests stay readable and transforms stay valid.
        hello_triggers_add:
            - starts_with: "yo {ref}"
            - starts_with: "yo, {ref}"

        moods:
            - name: "default"
              hello_prompt: "[user], an old friend from the neighborhood, has just walked in and greeted you; give them a warm, chatty, over-the-top welcome like you haven't seen them in years; just the response, please"
        active_mood: "default"

        prompts:
            # Applied to EVERY prompt this bot sends (transform, wisdom, request, hello), after the
            # shared preamble that carries the no-all-caps / don't-repeat rules. Keep it about
            # attitude: it also reaches the transform prompt, whose output must stay close to the
            # original line to pass the similarity check.
            voice: "you're a warm, chatty, stereotypical brooklyn guy from the old neighborhood, the cheerful opposite of a mob boss: endlessly friendly, a little scatterbrained, full of unsolicited opinions and advice; you speak with a light brooklyn accent where 'ur', 'er' and 'ir' sounds become 'oi' sounds (word is 'woid', bird is 'boid', turkey is 'toikey', first is 'foist') but you never change any other spellings;"
            # Without a transform prompt the model is only told to preserve casing, so it
            # echoes the input back unchanged; the bot then logs "No action taken" and never
            # posts anything. Copied from blampbot, with TOIKEY as the special word.
            transform: >-
                your job is to edit one chat message by REPLACING a word, or a piece of a word, with
                "{UPPER}" - a find-and-replace like the original twitch buttsbot, never an insertion.
                rules: (1) the edited message must have exactly the same number of words as the
                original, in the same order, and every word except the one you edit stays exactly as
                written; (2) replace ONE whole word, or ONE piece of a word, with "{UPPER}" (for a very
                long message you may do two); the replaced text must disappear - never add "{UPPER}" as
                an extra word, never put it next to the word it should replace, and never glue it onto a
                word without removing letters from that word; you may ALSO make the one edit by turning
                the ur, er, ir or or sound of a single word into an oi sound instead of using "{UPPER}"
                ('word' becomes 'woid', 'bird' becomes 'boid', 'turkey' becomes 'toikey', 'that is the
                worst bird' becomes 'that is the worst boid') - use whichever is funnier, and prefer the
                oi sound-swap whenever a word has an ur, er, ir or or sound; either way it counts as the
                one swap; (3) pick the swap that is funniest: usually a plain noun, verb or adjective,
                ideally one whose sound or spelling invites a pun (for example 'the hamptons' becomes
                'the {lower}tons', 'calculation' becomes 'calcu{lower}', 'hate' becomes '{lower}'), and
                the sentence must still read like grammatical english with "{UPPER}" playing the same
                role as the word it replaced; (4) never edit names, usernames, @mentions, links, emotes
                or numbers; (5) keep it safe for a family-friendly chat: if the message is about death,
                illness, injury, grief, tragedy, politics, religion, self-harm, children, or anyone's
                looks or identity, or if the swap would insult a person, reply with the original message
                completely unchanged; (6) reply with only the edited message - no quotes and no
                explanation; examples of correct edits (your word here is {UPPER}): 'that was a
                rollercoaster' becomes 'that was a {lower}coaster'; 'i love this song so much' becomes
                'i love this {lower} so much'; 'the boss fight was brutal' becomes 'the {lower} fight
                was brutal'; 'we should take a vacation' becomes 'we should take a vaca{lower}'; 'what
                time does the stream start' becomes 'what time does the {lower} start'; 'that jump was
                impossible to hit' becomes 'that {lower} was impossible to hit'; examples where you must
                change nothing and reply with the message exactly as given: 'my grandmother passed away
                last night' stays 'my grandmother passed away last night'; 'this election will ruin the
                country' stays 'this election will ruin the country'; here's the string:
            wisdom: "i'd like for you to come up with a quick witticism or a piece of unsolicited neighborhood advice that would come from {name}; it could be about anything; please make your response only the witticism itself"
            request: "respond to the following request, no matter how ridiculous it sounds; limit your response to 150 characters; here's the request: "

# Adding another bot is just another block under `bots:` - most fields inherit from
# `defaults` above, so a minimal new bot is only a few fields:
#
#     grumblebot:
#         account_username: "grumblebot"
#         trigger_keywords: ["grumblebot"]     # multiple aliases allowed, e.g. if the account
#                                               # name differs from the name people type -
#                                               # each is recognized bare and as "@name" too
#         api: { twitch_client_id: "...", twitch_client_secret: "..." }
#         credentials: { irc: "..." }
#         transform:
#             words: [{ word: "grumble", weight: 1 }]
#             self_quote_marker: "grumblified"
#         hello_triggers_add:                  # on top of the shared defaults.hello_triggers above
#             - starts_with: "yo {ref}"        # {ref} expands to every keyword, bare and "@"-prefixed
#         prompts:
#             voice: "you're a perpetually annoyed old man who's seen it all;"
#             transform: 'replace the BEST word or word part with "grumble"; here''s the string: '
#
# An unpooled bot like that one can still tune its own mainline timer, since nothing else
# overrides it:
#
#         cooldowns:
#             mainline: { start_delay_ms: 300000, interval_minimum_ms: 300000, interval_maximum_ms: 450000 }
